static func unlocked(slot: Dictionary) -> bool:
	return slot.get("finished",false)

static func phase(slot: Dictionary) -> String:
	var ledger: Dictionary = slot.get("afterstory",{})
	var resolution: String = ledger.get("resolution","")
	if resolution in ["public","witness"]:
		return resolution
	return "records" if ledger.get("ledger",false) else "arrivals"

static func music(_current_phase: String, field: String) -> String:
	return "palace" if field == "tidal_fort" else "village"

