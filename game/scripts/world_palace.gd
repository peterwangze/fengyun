static func unlocked(slot: Dictionary) -> bool:
	return int(slot.get("chapter",0)) >= 4

static func phase(slot: Dictionary) -> String:
	var marks: Dictionary = slot.get("chronicle",{}).get("marks",{})
	if slot.chapter >= 5 or marks.has("fire_signal") or marks.has("evacuated"):
		return "aftermath"
	return "transfer" if slot.get("campaign",{}).get("rescued",false) else "edict"

static func music(current_phase: String, field: String) -> String:
	if current_phase == "aftermath":
		return "blood"
	return "palace" if field != "tearoom" else "inn"

